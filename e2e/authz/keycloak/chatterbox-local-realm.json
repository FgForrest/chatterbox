{
    "realm": "chatterbox-local",
    "enabled": true,
    "sslRequired": "none",
    "registrationAllowed": false,
    "resetPasswordAllowed": false,
    "roles": {
        "client": {
            "chatterbox": [
                {
                    "name": "use"
                },
                {
                    "name": "org.curate"
                },
                {
                    "name": "access.manage"
                }
            ],
            "chatterbox-mcp": [
                {
                    "name": "knowledge:read"
                },
                {
                    "name": "transcripts:read"
                },
                {
                    "name": "summaries:read"
                },
                {
                    "name": "tasks:read"
                },
                {
                    "name": "tasks:write"
                },
                {
                    "name": "mail:read"
                }
            ]
        }
    },
    "groups": [
        {
            "id": "3feea890-10fb-48c1-961b-1253a5fe9061",
            "name": "Users",
            "clientRoles": {
                "chatterbox": [
                    "use"
                ],
                "realm-management": []
            }
        },
        {
            "id": "0264aed5-d8ba-4cb4-a5c9-a6a37e380eb2",
            "name": "Organization curators",
